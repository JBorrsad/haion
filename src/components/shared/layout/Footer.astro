---
import Logo from "./Logo.astro"
---

<footer class="bg-gray-800 text-white relative z-10">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Logo de Haion Consulting -->
      <div class="lg:col-span-1">
        <div class="mb-6">
          <Logo class="w-40 h-auto text-white" />
        </div>
      </div>

      <!-- Datos de contacto -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">HAION CONSULTING</h3>
        <div class="space-y-3 text-sm text-gray-300">
          <div class="flex items-start gap-2">
            <svg class="size-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <p>C/ Provincias 5, 1ª Planta</p>
              <p>31002 Pamplona, Navarra</p>
            </div>
          </div>
          <a href="tel:+34620327299" class="flex items-center gap-2 hover:text-yellow-400 transition-colors">
            <svg class="size-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <p>620 327 299</p>
          </a>
          <a href="mailto:info@haion-consulting.es" class="flex items-center gap-2 hover:text-yellow-400 transition-colors">
            <svg class="size-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <p>info@haion-consulting.es</p>
          </a>
        </div>
      </div>

      <!-- Menú -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Menú</h3>
        <ul class="space-y-2 text-sm text-gray-300">
          <li><a href="/" class="hover:text-orange-400 transition-colors">Inicio</a></li>
          <li><a href="/#sobre-nosotros" class="hover:text-orange-400 transition-colors">Nosotros</a></li>
          <li><a href="/#servicios" class="hover:text-orange-400 transition-colors">Servicios</a></li>
          <li><a href="/fiscal" class="hover:text-orange-400 transition-colors">Fiscal</a></li>
          <li><a href="/laboral" class="hover:text-orange-400 transition-colors">Laboral</a></li>
          <li><a href="/contable" class="hover:text-orange-400 transition-colors">Contable</a></li>
          <li><a href="/contacto" class="hover:text-orange-400 transition-colors">Contacto</a></li>
          <li><a href="/aviso-legal" class="hover:text-orange-400 transition-colors">Aviso Legal</a></li>
        </ul>
      </div>

      <!-- Texto fijo -->
      <div>
        <p class="text-gray-300 text-sm leading-relaxed">
          Gestión clara, compromiso real.
          No se trata de parecer expertos, sino de serlo.
        </p>
      </div>

    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-700 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center">
      <div class="text-sm text-gray-400 mb-4 md:mb-0">
        <p>© 2025 Haion Consulting</p>
      </div>
      
      <div class="text-sm text-gray-400">
        <p>Desarrollado por <a href="https://juan-borras.es" target="_blank" rel="noopener noreferrer" class="text-yellow-400 hover:text-yellow-300 transition-colors underline">Juan Borrás</a></p>
      </div>
    </div>
  </div>
</footer>
